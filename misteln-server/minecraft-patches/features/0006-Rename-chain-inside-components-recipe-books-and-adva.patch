Subject: [PATCH] Rename chain inside components, recipe books and advancements


diff --git a/ca/spottedleaf/dataconverter/minecraft/versions/V4307.java b/ca/spottedleaf/dataconverter/minecraft/versions/V4307.java
index bd930debf33ffe9275e0d736233678f710770e7b..8feebf9dcdbb28dc27ba7c198be8b6579641bb89 100644
--- a/ca/spottedleaf/dataconverter/minecraft/versions/V4307.java
+++ b/ca/spottedleaf/dataconverter/minecraft/versions/V4307.java
@@ -218,7 +218,49 @@ public final class V4307 {
                 return null;
             }
         });
+
+        // Misteln start - walk the other components that name blocks, items or recipes, so renames like chain -> iron_chain reach them
+        MCTypeRegistry.DATA_COMPONENTS.addStructureWalker(VERSION, new DataWalker<>() {
+            @Override
+            public MapType walk(final MapType root, final long fromVersion, final long toVersion) {
+                final MapType tool = root.getMap("minecraft:tool");
+                final ListType rules = tool == null ? null : tool.getListUnchecked("rules");
+                if (rules != null) {
+                    for (int i = 0, len = rules.size(); i < len; ++i) {
+                        mistelnConvertHolderSet(MCTypeRegistry.BLOCK_NAME, rules.getMap(i, null), "blocks", fromVersion, toVersion);
+                    }
+                }
+                mistelnConvertHolderSet(MCTypeRegistry.ITEM_NAME, root.getMap("minecraft:repairable"), "items", fromVersion, toVersion);
+                mistelnConvertHolderSet(MCTypeRegistry.ITEM_NAME, root.getMap("minecraft:lock"), "items", fromVersion, toVersion);
+                WalkerUtils.convertKeys(MCTypeRegistry.BLOCK_NAME, root, "minecraft:debug_stick_state", fromVersion, toVersion);
+                WalkerUtils.convertList(MCTypeRegistry.RECIPE, root, "minecraft:recipes", fromVersion, toVersion);
+                return null;
+            }
+        });
+        // a container's lock predicate; the only tile entity structure walker list is the one of V99
+        MCTypeRegistry.TILE_ENTITY.addStructureWalker(V99.VERSION, new DataWalker<>() {
+            @Override
+            public MapType walk(final MapType data, final long fromVersion, final long toVersion) {
+                mistelnConvertHolderSet(MCTypeRegistry.ITEM_NAME, data.getMap("lock"), "items", fromVersion, toVersion);
+                return null;
+            }
+        });
+        // Misteln end - walk the other components that name blocks, items or recipes, so renames like chain -> iron_chain reach them
+    }
+
+    // Misteln start - a holder set is a single id, a tag or a list of ids
+    private static void mistelnConvertHolderSet(final ca.spottedleaf.dataconverter.minecraft.datatypes.MCValueType type, final MapType data, final String path,
+                                                final long fromVersion, final long toVersion) {
+        if (data == null) {
+            return;
+        }
+        if (data.hasKey(path, ObjectType.LIST)) {
+            WalkerUtils.convertList(type, data, path, fromVersion, toVersion);
+        } else {
+            WalkerUtils.convert(type, data, path, fromVersion, toVersion);
+        }
     }
+    // Misteln end - a holder set is a single id, a tag or a list of ids
 
     private V4307() {}
 }
