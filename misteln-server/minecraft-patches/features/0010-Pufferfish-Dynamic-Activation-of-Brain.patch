diff --git a/org/brilliantw/misteln/MistelnConfig.java b/org/brilliantw/misteln/MistelnConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..9b288a91e2161e3f8b35a1d18d5d469a62fdbdf6
--- /dev/null
+++ b/org/brilliantw/misteln/MistelnConfig.java
@@ -0,0 +1,42 @@
+package org.brilliantw.misteln;
+
+import java.io.File;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.entity.EntityType;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+public final class MistelnConfig {
+    public static boolean dabEnabled;
+    public static int dabStartDistanceSquared = 12 * 12;
+    public static int dabMaxTickFreq = 20;
+    public static int dabActivationDistMod = 8;
+    public static boolean asyncMobSpawning;
+
+    private MistelnConfig() {
+    }
+
+    public static void init() {
+        final YamlConfiguration config = YamlConfiguration.loadConfiguration(new File("pufferfish.yml"));
+        dabEnabled = config.getBoolean("dab.enabled", false);
+        final int startDistance = Math.max(0, config.getInt("dab.start-distance", 12));
+        dabStartDistanceSquared = startDistance * startDistance;
+        dabMaxTickFreq = Math.max(1, config.getInt("dab.max-tick-freq", 20));
+        dabActivationDistMod = Math.clamp(config.getInt("dab.activation-dist-mod", 8), 0, 30);
+        asyncMobSpawning = config.getBoolean("enable-async-mob-spawning", false);
+
+        for (final EntityType<?> type : BuiltInRegistries.ENTITY_TYPE) {
+            type.dabEnabled = true;
+        }
+        for (final String name : config.getStringList("dab.blacklisted-entities")) {
+            BuiltInRegistries.ENTITY_TYPE.getOptional(net.minecraft.resources.Identifier.tryParse(name)).ifPresentOrElse(
+                type -> type.dabEnabled = false,
+                () -> MinecraftServer.LOGGER.warn("pufferfish.yml: unknown entity \"{}\" in dab.blacklisted-entities", name)
+            );
+        }
+        MinecraftServer.LOGGER.info(
+            "Misteln: dab={} (start {} blocks, max-tick-freq {}, dist-mod {}), async-mob-spawning={}",
+            dabEnabled, startDistance, dabMaxTickFreq, dabActivationDistMod, asyncMobSpawning
+        );
+    }
+}
