From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RICE0707 <master.end.9377@gmail.com>
Date: Tue, 15 Sep 2026 12:01:40 +0800
Subject: [PATCH] Fix shading glass and beacon


diff --git a/net/minecraft/world/level/block/entity/BeaconBlockEntity.java b/net/minecraft/world/level/block/entity/BeaconBlockEntity.java
index cc301cff64e1bf604a1432f6e36be8aa17db53e7..5379965319e8d2b4eb0263ff743270610d496fc6 100644
--- a/net/minecraft/world/level/block/entity/BeaconBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BeaconBlockEntity.java
@@ -69,6 +69,7 @@ public class BeaconBlockEntity extends BlockEntity implements MenuProvider, Name
     private List<BeaconBeamOwner.Section> checkingBeamSections = new ArrayList<>();
     public int levels;
     private int lastCheckY;
+    private boolean checkingTintedGlass = false; // Misteln - Fix shading glass and beacon
     @Nullable public Holder<MobEffect> primaryPower;
     @Nullable public Holder<MobEffect> secondaryPower;
     public @Nullable Component name;
@@ -176,11 +177,11 @@ public class BeaconBlockEntity extends BlockEntity implements MenuProvider, Name
         int y = pos.getY();
         int z = pos.getZ();
         BlockPos blockPos;
-        boolean isTintedGlass = false; // Purpur - allow beacon effects when covered by tinted glass
         if (blockEntity.lastCheckY < y) {
             blockPos = pos;
             blockEntity.checkingBeamSections = Lists.newArrayList();
             blockEntity.lastCheckY = pos.getY() - 1;
+            blockEntity.checkingTintedGlass = false; // Misteln - Fix shading glass and beacon
         } else {
             blockPos = new BlockPos(x, blockEntity.lastCheckY + 1, z);
         }
@@ -206,12 +207,12 @@ public class BeaconBlockEntity extends BlockEntity implements MenuProvider, Name
                     }
                 }
             } else {
-                if (level.purpurConfig.beaconAllowEffectsWithTintedGlass && blockState.getBlock().equals(Blocks.TINTED_GLASS)) {isTintedGlass = true;} // Purpur - allow beacon effects when covered by tinted glass
+                if (level.purpurConfig.beaconAllowEffectsWithTintedGlass && blockState.getBlock().equals(Blocks.TINTED_GLASS)) {blockEntity.checkingTintedGlass = true;} // Purpur - allow beacon effects when covered by tinted glass // Misteln - Fix shading glass and beacon
                 // Purpur start - fix effects being applied when tinted glass is covered
                 if (section == null || blockState.getLightBlock() >= 15 && !blockState.is(Blocks.BEDROCK) && !(blockState.getBlock().equals(Blocks.TINTED_GLASS) && level.purpurConfig.beaconAllowEffectsWithTintedGlass)) {
                     blockEntity.checkingBeamSections.clear();
                     blockEntity.lastCheckY = height;
-                    isTintedGlass = false;
+                    blockEntity.checkingTintedGlass = false; // Misteln - Fix shading glass and beacon
                     break;
                 }
                 // Purpur end - fix effects being applied when tinted glass is covered
@@ -225,11 +226,11 @@ public class BeaconBlockEntity extends BlockEntity implements MenuProvider, Name
 
         int i = blockEntity.levels; final int originalLevels = i; // Paper - OBFHELPER
         if (level.getGameTime() % 80L == 0L) {
-            if (!blockEntity.beamSections.isEmpty() || (level.purpurConfig.beaconAllowEffectsWithTintedGlass && isTintedGlass)) { // Purpur - fix beacon effects persisting with broken base while tinted glass is used
+            if (!blockEntity.beamSections.isEmpty() || (level.purpurConfig.beaconAllowEffectsWithTintedGlass && blockEntity.checkingTintedGlass)) { // Purpur - fix beacon effects persisting with broken base while tinted glass is used // Misteln - Fix shading glass and beacon
                 blockEntity.levels = updateBase(level, x, y, z);
             }
 
-            if (blockEntity.levels > 0 && (!blockEntity.beamSections.isEmpty() || (level.purpurConfig.beaconAllowEffectsWithTintedGlass && isTintedGlass))) { // Purpur - allow beacon effects when covered by tinted glass
+            if (blockEntity.levels > 0 && (!blockEntity.beamSections.isEmpty() || (level.purpurConfig.beaconAllowEffectsWithTintedGlass && blockEntity.checkingTintedGlass))) { // Purpur - allow beacon effects when covered by tinted glass // Misteln - Fix shading glass and beacon
                 applyEffects(level, pos, blockEntity.levels, blockEntity.primaryPower, blockEntity.secondaryPower, blockEntity); // Paper - Custom beacon ranges
                 playSound(level, pos, SoundEvents.BEACON_AMBIENT);
             }
