+import ca.spottedleaf.dataconverter.minecraft.converters.recipe.ConverterAbstractRecipeRename;
 import java.util.HashMap;
 import java.util.Map;
 
@@ -19,6 +20,7 @@ public final class V4541 {
     public static void register() {
         ConverterAbstractBlockRename.register(VERSION, CHAIN_RENAME::get);
         ConverterAbstractItemRename.register(VERSION, CHAIN_RENAME::get);
+        ConverterAbstractRecipeRename.register(VERSION, CHAIN_RENAME::get); // Misteln - the recipe was renamed too, it is in recipe books and knowledge books
     }
 
     private V4541() {}
diff --git a/net/minecraft/util/datafix/DataFixers.java b/net/minecraft/util/datafix/DataFixers.java
index 79685009e9ba6463ad27f45b70bed9b2b922ccda..06156bb49d12bf3544a68a0b4601589673ed066a 100644
--- a/net/minecraft/util/datafix/DataFixers.java
+++ b/net/minecraft/util/datafix/DataFixers.java
@@ -1589,6 +1589,7 @@ public class DataFixers {
         Schema schema275 = builder.addSchema(4541, SAME_NAMESPACED);
         builder.addFixer(BlockRenameFix.create(schema275, "Rename chain to iron_chain", createRenamer("minecraft:chain", "minecraft:iron_chain")));
         builder.addFixer(ItemRenameFix.create(schema275, "Rename chain to iron_chain", createRenamer("minecraft:chain", "minecraft:iron_chain")));
+        builder.addFixer(new AdvancementsRenameFix(schema275, false, "Rename chain recipe advancement", createRenamer("minecraft:recipes/decorations/chain", "minecraft:recipes/decorations/iron_chain"))); // Misteln - the recipe was renamed with the block
         Schema schema276 = builder.addSchema(4543, V4543::new);
         builder.addFixer(new AddNewChoices(schema276, "Added Mannequin", References.ENTITY));
         Schema schema277 = builder.addSchema(4544, SAME_NAMESPACED);
