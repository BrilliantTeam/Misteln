From: RICE0707 <master.end.9377@gmail.com>
Date: Thu, 17 Sep 2026 23:07:17 +0800
Subject: [PATCH] Keep world borders and removed server properties when
 upgrading from 1.21.10 or older


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 4af19f9f5152e9f6386e375a1ac5280ce00f48ea..abcce1f912f097ae91fe515830ac84d138bf80e8 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -738,6 +738,17 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             serverLevel.getWorld().getPopulators().addAll(serverLevel.generator.getDefaultPopulators(serverLevel.getWorld()));
         }
         this.initWorldBorder(serverLevelData, serverLevel);
+        // Misteln start - keep pvp, spawn-monsters and enable-command-block of worlds saved before 1.21.9 turned them into game rules
+        if (serverLevelData.mistelnPropertyGameRulesMissing) {
+            final Boolean pvp = net.minecraft.server.dedicated.DedicatedServerProperties.mistelnLegacyPvp;
+            final Boolean spawnMonsters = net.minecraft.server.dedicated.DedicatedServerProperties.mistelnLegacySpawnMonsters;
+            final Boolean commandBlocks = net.minecraft.server.dedicated.DedicatedServerProperties.mistelnLegacyEnableCommandBlock;
+            if (pvp != null) serverLevel.getGameRules().set(net.minecraft.world.level.gamerules.GameRules.PVP, pvp, serverLevel);
+            if (spawnMonsters != null) serverLevel.getGameRules().set(net.minecraft.world.level.gamerules.GameRules.SPAWN_MONSTERS, spawnMonsters, serverLevel);
+            if (commandBlocks != null) serverLevel.getGameRules().set(net.minecraft.world.level.gamerules.GameRules.COMMAND_BLOCKS_WORK, commandBlocks, serverLevel);
+            serverLevelData.mistelnPropertyGameRulesMissing = false;
+        }
+        // Misteln end - keep pvp, spawn-monsters and enable-command-block of worlds saved before 1.21.9 turned them into game rules
         this.server.getPluginManager().callEvent(new org.bukkit.event.world.WorldInitEvent(serverLevel.getWorld()));
     // Paper end - rework world loading process
         if (!serverLevelData.isInitialized()) {
@@ -777,19 +788,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                 WorldBorder.Settings settings = legacyWorldBorderSettings.get();
                 DimensionDataStorage dataStorage1 = serverLevel1.getDataStorage();
                 if (dataStorage1.get(WorldBorder.TYPE) == null) {
-                    double coordinateScale = serverLevel1.dimensionType().coordinateScale();
-                    WorldBorder.Settings settings1 = new WorldBorder.Settings(
-                        settings.centerX() / coordinateScale,
-                        settings.centerZ() / coordinateScale,
-                        settings.damagePerBlock(),
-                        settings.safeZone(),
-                        settings.warningBlocks(),
-                        settings.warningTime(),
-                        settings.size(),
-                        settings.lerpTime(),
-                        settings.lerpTarget()
-                    );
-                    WorldBorder worldBorder = new WorldBorder(settings1);
+                    WorldBorder worldBorder = new WorldBorder(mistelnBorderToTicks(settings)); // Misteln - DFU: the level.dat border counted seconds and milliseconds
                     worldBorder.applyInitialSettings(serverLevel1.getGameTime());
                     dataStorage1.set(WorldBorder.TYPE, worldBorder);
                 }
@@ -804,6 +803,23 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         // Paper end - rework world loading process
     }
 
+    // Misteln start - every world saved its own border in its own coordinates, so nothing is scaled; up to 1.21.10 the level.dat border counted seconds and milliseconds, not ticks
+    @com.google.common.annotations.VisibleForTesting
+    public static WorldBorder.Settings mistelnBorderToTicks(final WorldBorder.Settings settings) {
+        return new WorldBorder.Settings(
+            settings.centerX(),
+            settings.centerZ(),
+            settings.damagePerBlock(),
+            settings.safeZone(),
+            settings.warningBlocks(),
+            settings.warningTime() * 20,
+            settings.size(),
+            (settings.lerpTime() + 49L) / 50L,
+            settings.lerpTarget()
+        );
+    }
+    // Misteln end - every world saved its own border in its own coordinates, so nothing is scaled
+
     private static void setInitialSpawn(
         ServerLevel level, ServerLevelData levelData, boolean generateBonusChest, boolean debug, LevelLoadListener levelLoadListener
     ) {
diff --git a/net/minecraft/server/dedicated/DedicatedServerProperties.java b/net/minecraft/server/dedicated/DedicatedServerProperties.java
index 2a3b10c5e031ef44a2b53bc4fdc6e86c917f75d4..f1765ef2773ca1ecec7a714f486b8615d4a193e2 100644
--- a/net/minecraft/server/dedicated/DedicatedServerProperties.java
+++ b/net/minecraft/server/dedicated/DedicatedServerProperties.java
@@ -81,6 +81,20 @@ public class DedicatedServerProperties extends Settings<DedicatedServerPropertie
     public final String managementServerTlsKeystorePassword = this.get("management-server-tls-keystore-password", "");
     public final String managementServerAllowedOrigins = this.get("management-server-allowed-origins", "");
     public final @Nullable Boolean announcePlayerAchievements = this.getLegacyBoolean("announce-player-achievements");
+    // Misteln start - properties removed in 1.21.9, applied to the game rules of worlds saved before that
+    public static @Nullable Boolean mistelnLegacyPvp;
+    public static @Nullable Boolean mistelnLegacySpawnMonsters;
+    public static @Nullable Boolean mistelnLegacyEnableCommandBlock;
+    {
+        // the first read removes them from the file, later reloads keep the remembered values
+        final Boolean pvp = this.getLegacyBoolean("pvp");
+        final Boolean spawnMonsters = this.getLegacyBoolean("spawn-monsters");
+        final Boolean enableCommandBlock = this.getLegacyBoolean("enable-command-block");
+        if (pvp != null) mistelnLegacyPvp = pvp;
+        if (spawnMonsters != null) mistelnLegacySpawnMonsters = spawnMonsters;
+        if (enableCommandBlock != null) mistelnLegacyEnableCommandBlock = enableCommandBlock;
+    }
+    // Misteln end - properties removed in 1.21.9, applied to the game rules of worlds saved before that
     public final boolean enableQuery = this.get("enable-query", false);
     public final int queryPort = this.get("query.port", 25565);
     public final boolean enableRcon = this.get("enable-rcon", false);
