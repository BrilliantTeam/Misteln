     private long gameTime;
     private long dayTime;
     private final @Nullable CompoundTag loadedPlayerTag;
@@ -224,6 +225,7 @@ public class PrimaryLevelData implements ServerLevelData, WorldData {
             .read(net.minecraft.world.level.Level.RESOURCE_KEY_CODEC)
             .result()
             .orElse(data.respawnData.dimension());
+        data.mistelnPropertyGameRulesMissing = tag.get("game_rules").get("minecraft:pvp").result().isEmpty(); // Misteln - every rule is saved since 1.21.9
         return data;
