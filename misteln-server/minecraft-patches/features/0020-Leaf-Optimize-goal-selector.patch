--- /dev/null
+++ b/net/minecraft/world/entity/ai/goal/BinaryGoalSet.java
@@ -0,0 +1,77 @@
+package net.minecraft.world.entity.ai.goal;
+
+import java.util.AbstractSet;
+import java.util.Iterator;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+
+public final class BinaryGoalSet extends AbstractSet<WrappedGoal> {
+    private WrappedGoal[] elements = new WrappedGoal[4];
+    private int size;
+
+    @Override
+    public int size() {
+        return this.size;
+    }
+
+    @Override
+    public boolean add(final WrappedGoal goal) {
+        Objects.requireNonNull(goal);
+        final int priority = goal.getPriority();
+        int index = this.size;
+        for (int i = 0; i < this.size; i++) {
+            if (this.elements[i].equals(goal)) {
+                return false;
+            }
+            if (index == this.size && this.elements[i].getPriority() > priority) {
+                index = i;
+            }
+        }
+
+        if (this.size == this.elements.length) {
+            this.elements = java.util.Arrays.copyOf(this.elements, this.size + (this.size >> 1) + 1);
+        }
+        System.arraycopy(this.elements, index, this.elements, index + 1, this.size - index);
+        this.elements[index] = goal;
+        this.size++;
+        return true;
+    }
+
+    @Override
+    public Iterator<WrappedGoal> iterator() {
+        return new Iterator<>() {
+            private int cursor;
+            private int last = -1;
+
+            @Override
+            public boolean hasNext() {
+                return this.cursor < BinaryGoalSet.this.size;
+            }
+
+            @Override
+            public WrappedGoal next() {
+                if (!this.hasNext()) {
+                    throw new NoSuchElementException();
+                }
+                this.last = this.cursor;
+                return BinaryGoalSet.this.elements[this.cursor++];
+            }
+
+            @Override
+            public void remove() {
+                if (this.last == -1) {
+                    throw new IllegalStateException();
+                }
+                final BinaryGoalSet set = BinaryGoalSet.this;
+                System.arraycopy(set.elements, this.last + 1, set.elements, this.last, set.size - this.last - 1);
+                set.elements[--set.size] = null;
+                this.cursor = this.last;
+                this.last = -1;
+            }
+        };
+    }
+
+    public WrappedGoal[] elements() {
+        return this.elements;
+    }
+}
