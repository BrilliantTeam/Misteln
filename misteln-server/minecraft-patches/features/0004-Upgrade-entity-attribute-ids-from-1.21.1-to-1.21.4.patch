From: RICE0707 <master.end.9377@gmail.com>
Date: Tue, 15 Sep 2026 12:11:55 +0800
Subject: [PATCH] Upgrade entity attribute ids from 1.21.1 to 1.21.4


diff --git a/net/minecraft/world/entity/ai/attributes/AttributeInstance.java b/net/minecraft/world/entity/ai/attributes/AttributeInstance.java
index 3317f9b71f1c80092c25c1c2a325f67eddb3a944..4235f41c8457e370d0c5d8c2556f835f99426815 100644
--- a/net/minecraft/world/entity/ai/attributes/AttributeInstance.java
+++ b/net/minecraft/world/entity/ai/attributes/AttributeInstance.java
@@ -223,9 +223,28 @@ public class AttributeInstance {
             if (modifiers.isPresent()) {
                 attribute = attribute.set("modifiers", attribute.createList(modifiers.get().map(Packed::upgradeLegacyModifier)));
             }
+            // attribute ids lost their generic./horse./player./zombie. prefix in 1.21.2 (see V4055)
+            final java.util.Optional<String> id = attribute.get("id").asString().result();
+            if (id.isPresent()) {
+                attribute = attribute.set("id", attribute.createString(upgradeAttributeId(id.get())));
+            }
             return attribute;
         }
 
+        private static final String[] LEGACY_ATTRIBUTE_PREFIXES = {"generic.", "horse.", "player.", "zombie."};
+
+        private static String upgradeAttributeId(final String id) {
+            final net.minecraft.resources.Identifier location = net.minecraft.resources.Identifier.tryParse(id);
+            if (location != null && location.getNamespace().equals(net.minecraft.resources.Identifier.DEFAULT_NAMESPACE)) {
+                for (final String prefix : LEGACY_ATTRIBUTE_PREFIXES) {
+                    if (location.getPath().startsWith(prefix)) {
+                        return net.minecraft.resources.Identifier.withDefaultNamespace(location.getPath().substring(prefix.length())).toString();
+                    }
+                }
+            }
+            return id;
+        }
+
         private static <T> com.mojang.serialization.Dynamic<T> upgradeLegacyModifier(com.mojang.serialization.Dynamic<T> modifier) {
             final com.mojang.serialization.Dynamic<T> legacy = modifier;
             if (legacy.get("id").result().isEmpty()) {
