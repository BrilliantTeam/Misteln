+                }
+                int[] cap = entry.getValue();
+                net.minecraft.server.level.ServerPlayer[] playersArray = players.getRawDataUnchecked();
+                for (int i = 0, size = players.size(); i < size; i++) {
+                    int[] counts = playersArray[i].mobCounts;
+                    for (int j = 0; j < net.minecraft.server.level.ServerPlayer.MOBCATEGORY_TOTAL_ENUMS; j++) {
+                        counts[j] += cap[j];
+                    }
+                }
+            }
