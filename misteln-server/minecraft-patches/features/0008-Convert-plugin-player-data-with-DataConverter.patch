From: RICE0707 <master.end.9377@gmail.com>
Date: Thu, 17 Sep 2026 23:29:06 +0800
Subject: [PATCH] Convert plugin player data with DataConverter


diff --git a/net/minecraft/util/datafix/DataFixTypes.java b/net/minecraft/util/datafix/DataFixTypes.java
index d33a365dd9d04bd986457cbc5d909dc8ddf7112f..f0f215e2a8f08deb2eb111e8a03ef9dc350cf44f 100644
--- a/net/minecraft/util/datafix/DataFixTypes.java
+++ b/net/minecraft/util/datafix/DataFixTypes.java
@@ -76,6 +76,11 @@ public enum DataFixTypes {
     }
 
     public CompoundTag update(DataFixer fixer, CompoundTag tag, int version, int newVersion) {
+        // Misteln start - plugins store inventories as player data (e.g. Minepacks), convert them like the server converts players
+        if (this == PLAYER) {
+            return ca.spottedleaf.dataconverter.minecraft.MCDataConverter.convertTag(ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry.PLAYER, tag, version, newVersion);
+        }
+        // Misteln end - plugins store inventories as player data (e.g. Minepacks), convert them like the server converts players
         return (CompoundTag)this.update(fixer, new Dynamic<>(NbtOps.INSTANCE, tag), version, newVersion).getValue();
     }
 
