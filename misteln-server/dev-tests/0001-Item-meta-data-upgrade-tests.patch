+// Misteln - DFU: items serialized by 1.21.1 (data version 3955), 1.21.4 (4189), 1.21.8 (4440), 1.21.11 (4671) and 26.2 (4903) must still load
+@AllFeatures
+public class ItemMetaDataUpgradeTest {
+
+    private static final int V1_21_1 = 3955;
+    private static final int V1_21_4 = 4189;
+    private static final int V1_21_8 = 4440;
+    private static final int V1_21_11 = 4671;
+    private static final int V26_2 = 4903;
+
+    static String base64(CompoundTag tag) throws IOException {
+        ByteArrayOutputStream buf = new ByteArrayOutputStream();
+        NbtIo.writeCompressed(tag, buf);
+        return Base64.getEncoder().encodeToString(buf.toByteArray());
+    }
+
+    static ItemStack load(int version, String type, String meta) {
+        CraftItemFactory.instance(); // registers the ItemMeta serialization alias, like CraftServer does on startup
+        String yaml = "item:\n"
+            + "  ==: org.bukkit.inventory.ItemStack\n"
+            + "  v: " + version + "\n"
+            + "  type: " + type + "\n"
+            + "  meta:\n"
+            + "    ==: ItemMeta\n"
+            + meta;
+        ItemStack stack = YamlConfiguration.loadConfiguration(new StringReader(yaml)).getItemStack("item");
+        assertNotNull(stack, yaml);
+        return stack;
+    }
+
+    @Test
+    public void testItemMeta() throws IOException {
+        CompoundTag nested = new CompoundTag();
+        nested.putString("id", "minecraft:stone");
+        nested.putInt("count", 1);
+        CompoundTag nestedComponents = new CompoundTag();
+        nestedComponents.put("minecraft:fire_resistant", new CompoundTag());
+        nested.put("components", nestedComponents);
+        CompoundTag slot = new CompoundTag();
+        slot.putInt("slot", 0);
+        slot.put("item", nested);
+        ListTag container = new ListTag();
+        container.add(slot);
+        CompoundTag unhandled = new CompoundTag();
+        unhandled.putString("minecraft:lock", "secret");
+        unhandled.put("minecraft:container", container);
+
+        ItemStack stack = load(V1_21_1, "APPLE", ""
+            + "    meta-type: UNSPECIFIC\n"
+            + "    fire-resistant: true\n"
+            + "    food:\n"
+            + "      ==: Food\n"
+            + "      nutrition: 4\n"
+            + "      saturation: 2.4\n"
+            + "      can-always-eat: true\n"
+            + "      eat-seconds: 3.2\n"
+            + "      using-converts-to:\n"
+            + "        ==: org.bukkit.inventory.ItemStack\n"
+            + "        v: " + V1_21_1 + "\n"
+            + "        type: BOWL\n"
+            + "      effects:\n"
+            + "      - ==: FoodEffect\n"
+            + "        effect:\n"
+            + "          ==: PotionEffect\n"
+            + "          effect: minecraft:speed\n"
+            + "          duration: 200\n"
+            + "          amplifier: 1\n"
+            + "          ambient: false\n"
+            + "          has-particles: true\n"
+            + "          has-icon: true\n"
+            + "        probability: 0.5\n"
+            + "    unhandled: " + base64(unhandled) + "\n");
+
+        ItemMeta meta = stack.getItemMeta();
+        assertEquals(4, meta.getFood().getNutrition());
+        assertEquals(Material.BOWL, meta.getUseRemainder().getType());
+
+        net.minecraft.world.item.ItemStack nms = CraftItemStack.asNMSCopy(stack);
+        assertEquals(net.minecraft.tags.DamageTypeTags.IS_FIRE, nms.get(DataComponents.DAMAGE_RESISTANT).types().unwrapKey().orElse(null));
+        Consumable consumable = nms.get(DataComponents.CONSUMABLE); // an apple eats in 1.6 seconds by default
+        assertEquals(3.2F, consumable.consumeSeconds(), 1.0E-4F);
+        assertEquals(1, consumable.onConsumeEffects().size());
+        ApplyStatusEffectsConsumeEffect effect = (ApplyStatusEffectsConsumeEffect) consumable.onConsumeEffects().getFirst();
+        assertEquals(0.5F, effect.probability(), 1.0E-4F);
+        assertEquals(1, effect.effects().getFirst().getAmplifier());
+
+        assertNotNull(nms.get(DataComponents.LOCK), "lock string -> predicate");
+        assertTrue(nms.get(DataComponents.CONTAINER).copyOne().has(DataComponents.DAMAGE_RESISTANT), "nested fire_resistant -> damage_resistant");
+    }
