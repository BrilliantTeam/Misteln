+    @Test
+    public void testLegacyJsonText() {
+        ItemStack stack = load(V1_21_4, "STICK", ""
+            + "    meta-type: UNSPECIFIC\n"
+            + "    display-name: '{\"text\":\"shop\",\"bold\":\"true\",\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://example.com\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"hi\"}}'\n"
+            + "    lore:\n"
+            + "    - '{\"text\":\"run\",\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/spawn\"}}'\n"
+            + "    - plain line\n"
+            + "    hide-tool-tip: true\n");
+
+        net.minecraft.world.item.ItemStack nms = CraftItemStack.asNMSCopy(stack);
+        net.minecraft.network.chat.Component name = nms.get(DataComponents.CUSTOM_NAME);
+        assertEquals("shop", name.getString());
+        assertTrue(name.getStyle().isBold(), "string boolean -> boolean");
+        assertInstanceOf(net.minecraft.network.chat.ClickEvent.OpenUrl.class, name.getStyle().getClickEvent());
+        assertInstanceOf(net.minecraft.network.chat.HoverEvent.ShowText.class, name.getStyle().getHoverEvent());
+
+        java.util.List<net.minecraft.network.chat.Component> lore = nms.get(DataComponents.LORE).lines();
+        assertEquals("/spawn", ((net.minecraft.network.chat.ClickEvent.RunCommand) lore.get(0).getStyle().getClickEvent()).command());
+        assertEquals("plain line", lore.get(1).getString());
+
+        assertTrue(stack.getItemMeta().isHideTooltip(), "hide-tool-tip -> tooltip display");
+    }
