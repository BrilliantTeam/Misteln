+    @Test
+    public void testEntityAttributeIds() {
+        CompoundTag renamed = new CompoundTag();
+        renamed.putString("id", "minecraft:generic.max_health");
+        renamed.putDouble("base", 40.0);
+        CompoundTag legacy = new CompoundTag();
+        legacy.putString("Name", "generic.movement_speed");
+        legacy.putDouble("Base", 0.5);
+        ListTag list = new ListTag();
+        list.add(renamed);
+        list.add(legacy);
+
+        AttributeMap map = new AttributeMap(DefaultAttributes.getSupplier(net.minecraft.world.entity.EntityTypes.ZOMBIE));
+        map.apply(AttributeInstance.Packed.LIST_CODEC.parse(NbtOps.INSTANCE, list).getOrThrow());
+
+        assertEquals(40.0, map.getBaseValue(Attributes.MAX_HEALTH));
+        assertEquals(0.5, map.getBaseValue(Attributes.MOVEMENT_SPEED));
+    }
