From: RICE0707 <master.end.9377@gmail.com>
Date: Sat, 19 Sep 2026 10:22:44 +0800
Subject: [PATCH] Upgrade Bukkit item meta data from 1.21.11 to 26.2


diff --git a/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java b/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java
index 0d9b3cc928bd5b460f56aeaefe829a8d24093b05..4f3e6886e89b8756b0881b60309fddc554e3eb57 100644
--- a/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java
+++ b/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java
@@ -59,8 +59,8 @@ public final class ConfigSerializationUtil {
 
     public static <T> HolderSet<T> getHolderSet(Object from, ResourceKey<Registry<T>> registryKey) {
         Registry<T> registry = CraftRegistry.getMinecraftRegistry(registryKey);
-        if (from instanceof String parseString && parseString.startsWith("#")) { // Tag
-            parseString = parseString.substring(1);
+        if (from instanceof String parseString) { // Tag
+            parseString = parseString.startsWith("#") ? parseString.substring(1) : parseString; // Misteln - DFU: a tag was written without the leading # before 26.1 (damage-resistant)
             Identifier key = Identifier.tryParse(parseString);
             if (key != null) {
                 Optional<HolderSet.Named<T>> tag = registry.get(TagKey.create(registryKey, key));
