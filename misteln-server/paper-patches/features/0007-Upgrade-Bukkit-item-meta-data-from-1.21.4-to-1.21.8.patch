+    // text components were json with camelCase click/hover events and string booleans before 1.21.5 (see V4290, V4291, V4292)
+    static boolean needsTextUpgrade(final int version) {
+        return version < ca.spottedleaf.dataconverter.minecraft.versions.V4290.VERSION;
+    }
+
+    // json text as written by Bukkit (display name, lore, book pages), null if it is not json or needs no upgrade
+    static net.minecraft.network.chat.@Nullable Component upgradeText(final @Nullable String json, final int fromVersion) {
+        if (json == null || !needsTextUpgrade(fromVersion)) {
+            return null;
+        }
+        try {
+            final com.google.gson.JsonElement element = com.google.gson.JsonParser.parseString(json);
+            if (!element.isJsonObject() && !element.isJsonArray()) {
+                return null; // plain (legacy formatted) text is read the same by every version
+            }
+        } catch (final RuntimeException ex) {
+            return null;
+        }
+        final Object converted = MCDataConverter.convert(MCTypeRegistry.TEXT_COMPONENT, json, fromVersion, CraftMagicNumbers.INSTANCE.getDataVersion());
+        final net.minecraft.nbt.Tag tag = switch (converted) {
+            case ca.spottedleaf.dataconverter.types.nbt.NBTMapType map -> map.getTag();
+            case ca.spottedleaf.dataconverter.types.nbt.NBTListType list -> list.getTag();
+            case String string -> net.minecraft.nbt.StringTag.valueOf(string);
+            case null, default -> null;
+        };
+        if (tag == null) {
+            return null;
+        }
+        return net.minecraft.network.chat.ComponentSerialization.CODEC
+            .parse(org.bukkit.craftbukkit.CraftRegistry.getMinecraftRegistry().createSerializationContext(net.minecraft.nbt.NbtOps.INSTANCE), tag)
+            .result().orElse(null);
+    }
 }
