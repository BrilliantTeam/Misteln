diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java b/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
index d4b67ca67f3f181341da7f687534b46e12b0f664..96bad339994d4d954bf00400575ae301a8b38a55 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
@@ -2,7 +2,13 @@ package org.bukkit.craftbukkit.inventory;
 
 import ca.spottedleaf.dataconverter.minecraft.MCDataConverter;
 import ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry;
+import java.util.Map;
 import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.SpawnEggItem;
 import net.minecraft.world.level.block.entity.BlockEntityType;
 import org.bukkit.craftbukkit.util.CraftMagicNumbers;
 import org.jspecify.annotations.Nullable;
@@ -17,6 +23,37 @@ final class ItemMetaDataUpgrader {
     private ItemMetaDataUpgrader() {
     }
 
+    // entity data is only saved with an id (CustomData.CODEC_WITH_ID), Bukkit kept id-less entity tags (pre 1.20.5 EntityTag, SpawnEggMeta#setCustomSpawnedType(null))
+    // which belong to the entity of the item, the tag stays as is if there is no item to take the id from
+    static CompoundTag entityData(final CompoundTag tag, final @Nullable EntityType<?> itemEntityType) {
+        if (itemEntityType == null || tag.getString("id").isPresent()) {
+            return tag;
+        }
+        final CompoundTag copy = tag.copy();
+        copy.putString("id", EntityType.getKey(itemEntityType).toString());
+        return copy;
+    }
+
+    private static final Map<Item, EntityType<?>> ITEM_ENTITY_TYPES = Map.of(
+        Items.ARMOR_STAND, EntityType.ARMOR_STAND,
+        Items.ITEM_FRAME, EntityType.ITEM_FRAME,
+        Items.GLOW_ITEM_FRAME, EntityType.GLOW_ITEM_FRAME,
+        Items.PAINTING, EntityType.PAINTING,
+        Items.COD_BUCKET, EntityType.COD,
+        Items.SALMON_BUCKET, EntityType.SALMON,
+        Items.PUFFERFISH_BUCKET, EntityType.PUFFERFISH,
+        Items.TADPOLE_BUCKET, EntityType.TADPOLE,
+        Items.AXOLOTL_BUCKET, EntityType.AXOLOTL,
+        Items.TROPICAL_FISH_BUCKET, EntityType.TROPICAL_FISH
+    );
+
+    static @Nullable EntityType<?> entityTypeOf(final ItemStack item) {
+        if (item.getItem() instanceof SpawnEggItem spawnEgg) {
+            return spawnEgg.getType(org.bukkit.craftbukkit.CraftRegistry.getMinecraftRegistry(), item.getItem().getDefaultInstance());
+        }
+        return ITEM_ENTITY_TYPES.get(item.getItem());
+    }
+
     static boolean needsUpgrade(final int version) {
         return version < CraftMagicNumbers.INSTANCE.getDataVersion();
     }
diff --git a/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java b/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java
index 024f14d4f360663c5a2dc32f237dc97d410b5952..47cf034ec0fb35902dbb3d7f4c42ffd0081b0d92 100644
--- a/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java
+++ b/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java
@@ -470,4 +470,42 @@ public class ItemMetaDataUpgradeTest {
         assertFalse(apiNms.get(DataComponents.BUCKET_ENTITY_DATA).copyTag().contains("Variant"));
         assertEquals(api, CraftItemStack.asBukkitCopy(apiNms), "variant component round trip");
     }
+
+    @Test
+    public void testEntityTagWithoutId() throws IOException {
+        net.minecraft.core.RegistryAccess registries = org.bukkit.craftbukkit.CraftRegistry.getMinecraftRegistry();
+
+        CompoundTag frame = new CompoundTag();
+        frame.putBoolean("Invisible", true);
+        CompoundTag frameInternal = new CompoundTag();
+        frameInternal.put("EntityTag", frame);
+        ItemStack frameStack = load(V1_21_4, "ITEM_FRAME", ""
+            + "    meta-type: ENTITY_TAG\n"
+            + "    internal: " + base64(frameInternal) + "\n");
+        net.minecraft.world.item.ItemStack frameNms = CraftItemStack.asNMSCopy(frameStack);
+        CompoundTag frameData = frameNms.get(DataComponents.ENTITY_DATA).copyTag();
+        assertEquals("minecraft:item_frame", frameData.getStringOr("id", ""));
+        assertTrue(frameData.getBooleanOr("Invisible", false), "the EntityTag of an entity tag meta must be kept");
+        assertTrue(net.minecraft.world.item.ItemStack.CODEC.encodeStart(registries.createSerializationContext(NbtOps.INSTANCE), frameNms).isSuccess(), "the item must be savable");
+
+        CompoundTag egg = new CompoundTag();
+        egg.putBoolean("NoAI", true);
+        CompoundTag eggInternal = new CompoundTag();
+        eggInternal.put("entity-tag", egg);
+        ItemStack eggStack = load(V1_21_4, "PIG_SPAWN_EGG", ""
+            + "    meta-type: SPAWN_EGG\n"
+            + "    internal: " + base64(eggInternal) + "\n");
+        CompoundTag eggData = CraftItemStack.asNMSCopy(eggStack).get(DataComponents.ENTITY_DATA).copyTag();
+        assertEquals("minecraft:pig", eggData.getStringOr("id", ""));
+        assertTrue(eggData.getBooleanOr("NoAI", false));
+
+        org.bukkit.inventory.meta.SpawnEggMeta meta = (org.bukkit.inventory.meta.SpawnEggMeta) new ItemStack(Material.ZOMBIE_SPAWN_EGG).getItemMeta();
+        meta.setCustomSpawnedType(org.bukkit.entity.EntityType.PIG);
+        meta.setCustomSpawnedType(null);
+        ItemStack api = new ItemStack(Material.ZOMBIE_SPAWN_EGG);
+        api.setItemMeta(meta);
+        net.minecraft.world.item.ItemStack apiNms = CraftItemStack.asNMSCopy(api);
+        assertEquals("minecraft:zombie", apiNms.get(DataComponents.ENTITY_DATA).copyTag().getStringOr("id", ""));
+        assertTrue(net.minecraft.world.item.ItemStack.CODEC.encodeStart(registries.createSerializationContext(NbtOps.INSTANCE), apiNms).isSuccess(), "the item must be savable");
+    }
 }
