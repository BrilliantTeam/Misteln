Subject: [PATCH] Handle block state item meta upgrade


diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
index 4a8fbba451afb8d22fc9ae973911d179a8c81aeb..20e13a8ddc69f18ee154ddf9208124fffe593c8a 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
@@ -142,7 +142,7 @@ public class CraftMetaBlockState extends CraftMetaItem implements BlockStateMeta
         this.material = material != null ? material : Material.AIR;
         if (this.internalTag != null) {
             this.setBlockState(CraftMetaBlockState.getBlockState(this.material, this.internalTag)); // Paper - general item meta fixes - pass through setter
-            this.internalTag = null;
+            // this.internalTag = null; // Misteln - delay removal for dfu
         }
         // Paper start - general item meta fixes - parse spigot legacy position and merge into block entity tag
         final BlockVector legacyPosition = SerializableMeta.getObject(BlockVector.class, map, "blockPosition", true);
@@ -232,6 +232,26 @@ public class CraftMetaBlockState extends CraftMetaItem implements BlockStateMeta
         return builder;
     }
 
+    // Misteln start - perform nbt upgrade
+    @Override
+    public void setVersion(int version) {
+        super.setVersion(version);
+
+        if (version < org.bukkit.Bukkit.getUnsafe().getDataVersion()) {
+            if (internalTag == null) return;
+
+            internalTag = ca.spottedleaf.dataconverter.minecraft.MCDataConverter.convertTag(ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry.TILE_ENTITY, internalTag,
+                    version, org.bukkit.Bukkit.getUnsafe().getDataVersion());
+
+            deserializeInternal(internalTag, null);
+
+            this.setBlockState(CraftMetaBlockState.getBlockState(this.material, this.internalTag));
+        }
+
+        internalTag = null;
+    }
+    // Misteln end
+
     @Override
     int applyHash() {
         final int original;
