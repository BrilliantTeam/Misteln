diff --git a/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java b/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java
index ffbcf189b87034b03270618cddb218eb6a29df1c..0d9b3cc928bd5b460f56aeaefe829a8d24093b05 100644
--- a/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java
+++ b/src/main/java/org/bukkit/craftbukkit/configuration/ConfigSerializationUtil.java
@@ -77,7 +77,7 @@ public final class ConfigSerializationUtil {
                     continue;
                 }
 
-                registry.get(key).ifPresent(holderList::add);
+                registry.get(key).or(() -> mistelnRenamed(registryKey, registry, key)).ifPresent(holderList::add); // Misteln - DFU
             }
 
             return HolderSet.direct(holderList);
@@ -88,6 +88,25 @@ public final class ConfigSerializationUtil {
         return HolderSet.empty();
     }
 
+    // Misteln start - DFU: ids in serialized components (which exist since 1.20.5) that were renamed since, like chain -> iron_chain in 1.21.9
+    private static <T> Optional<Holder.Reference<T>> mistelnRenamed(ResourceKey<Registry<T>> registryKey, Registry<T> registry, Identifier key) {
+        final ca.spottedleaf.dataconverter.minecraft.datatypes.MCValueType type;
+        if (registryKey.equals(net.minecraft.core.registries.Registries.BLOCK)) {
+            type = ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry.BLOCK_NAME;
+        } else if (registryKey.equals(net.minecraft.core.registries.Registries.ITEM)) {
+            type = ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry.ITEM_NAME;
+        } else if (registryKey.equals(net.minecraft.core.registries.Registries.ENTITY_TYPE)) {
+            type = ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry.ENTITY_NAME;
+        } else {
+            return Optional.empty();
+        }
+        final Object renamed = ca.spottedleaf.dataconverter.minecraft.MCDataConverter.convert(type, key.toString(),
+            ca.spottedleaf.dataconverter.minecraft.MCVersions.V1_20_5, org.bukkit.craftbukkit.util.CraftMagicNumbers.INSTANCE.getDataVersion());
+        final Identifier renamedKey = renamed instanceof String name ? Identifier.tryParse(name) : null;
+        return renamedKey == null || renamedKey.equals(key) ? Optional.empty() : registry.get(renamedKey);
+    }
+    // Misteln end - DFU: ids in serialized components (which exist since 1.20.5) that were renamed since, like chain -> iron_chain in 1.21.9
+
     private ConfigSerializationUtil() {
     }
 }
