diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java b/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
index 5b445713fa75bb0df9f55e46f42e68ca5fdf64f8..fe5c7781accf56f22b39fd780313e2f71da2dd26 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
@@ -2,7 +2,15 @@ package org.bukkit.craftbukkit.inventory;
 
 import ca.spottedleaf.dataconverter.minecraft.MCDataConverter;
 import ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry;
+import java.util.Map;
+import net.minecraft.core.component.DataComponents;
 import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.component.TypedEntityData;
 import net.minecraft.world.level.block.entity.BlockEntityType;
 import org.bukkit.craftbukkit.util.CraftMagicNumbers;
 import org.jspecify.annotations.Nullable;
@@ -17,6 +25,32 @@ final class ItemMetaDataUpgrader {
     private ItemMetaDataUpgrader() {
     }
 
+    // entity data is typed since 1.21.9 and needs an id, Bukkit kept id-less entity tags (pre 1.20.5 EntityTag, SpawnEggMeta#setCustomSpawnedType(null))
+    // which belong to the entity of the item, null if the id is unknown and there is no item to take it from
+    static @Nullable TypedEntityData<EntityType<?>> entityData(final CompoundTag tag, final @Nullable EntityType<?> itemEntityType) {
+        final EntityType<?> type = tag.read("id", EntityType.CODEC).orElse(itemEntityType);
+        return type == null ? null : TypedEntityData.of(type, tag.copy());
+    }
+
+    private static final Map<Item, EntityType<?>> ITEM_ENTITY_TYPES = Map.of(
+        Items.ARMOR_STAND, EntityTypes.ARMOR_STAND,
+        Items.ITEM_FRAME, EntityTypes.ITEM_FRAME,
+        Items.GLOW_ITEM_FRAME, EntityTypes.GLOW_ITEM_FRAME,
+        Items.PAINTING, EntityTypes.PAINTING,
+        Items.COD_BUCKET, EntityTypes.COD,
+        Items.SALMON_BUCKET, EntityTypes.SALMON,
+        Items.PUFFERFISH_BUCKET, EntityTypes.PUFFERFISH,
+        Items.TADPOLE_BUCKET, EntityTypes.TADPOLE,
+        Items.AXOLOTL_BUCKET, EntityTypes.AXOLOTL,
+        Items.TROPICAL_FISH_BUCKET, EntityTypes.TROPICAL_FISH
+    );
+
+    // spawn eggs carry their entity as a default component since 1.21.9
+    static @Nullable EntityType<?> entityTypeOf(final ItemStack item) {
+        final TypedEntityData<EntityType<?>> prototype = item.getPrototype().get(DataComponents.ENTITY_DATA);
+        return prototype != null ? prototype.type() : ITEM_ENTITY_TYPES.get(item.getItem());
+    }
+
     static boolean needsUpgrade(final int version) {
         return version < CraftMagicNumbers.INSTANCE.getDataVersion();
     }
diff --git a/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java b/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java
index e8fe8955fe140cfdda3b95e2351e8208b7fd6c25..5554a9502b7bdc5a40d63d8d33ac10c056e752b2 100644
--- a/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java
+++ b/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgradeTest.java
@@ -27,12 +27,13 @@ import org.bukkit.support.environment.AllFeatures;
 import org.bukkit.tag.DamageTypeTags;
 import org.junit.jupiter.api.Test;
 
-// Misteln - DFU: items serialized by 1.21.1 (data version 3955) and 1.21.4 (4189) must still load
+// Misteln - DFU: items serialized by 1.21.1 (data version 3955), 1.21.4 (4189) and 1.21.8 (4440) must still load
 @AllFeatures
 public class ItemMetaDataUpgradeTest {
 
     private static final int V1_21_1 = 3955;
     private static final int V1_21_4 = 4189;
+    private static final int V1_21_8 = 4440;
 
     static String base64(CompoundTag tag) throws IOException {
         ByteArrayOutputStream buf = new ByteArrayOutputStream();
@@ -470,4 +471,69 @@ public class ItemMetaDataUpgradeTest {
         assertFalse(apiNms.get(DataComponents.BUCKET_ENTITY_DATA).copyTag().contains("Variant"));
         assertEquals(api, CraftItemStack.asBukkitCopy(apiNms), "variant component round trip");
     }
+
+    @Test
+    public void testChainAndSpearAnimation() throws IOException {
+        CompoundTag chain = new CompoundTag();
+        chain.putString("id", "minecraft:chain");
+        chain.putInt("count", 3);
+        CompoundTag slot = new CompoundTag();
+        slot.putInt("slot", 0);
+        slot.put("item", chain);
+        ListTag container = new ListTag();
+        container.add(slot);
+        CompoundTag consumable = new CompoundTag();
+        consumable.putString("animation", "spear");
+        CompoundTag unhandled = new CompoundTag();
+        unhandled.put("minecraft:container", container);
+        unhandled.put("minecraft:consumable", consumable);
+
+        // 1.21.4 servers upgrade straight to this version, without re-saving on 1.21.8 first
+        for (int version : new int[]{V1_21_4, V1_21_8}) {
+            ItemStack stack = load(version, "CHAIN", ""
+                + "    meta-type: UNSPECIFIC\n"
+                + "    unhandled: " + base64(unhandled) + "\n");
+
+            assertEquals(Material.IRON_CHAIN, stack.getType(), "chain -> iron_chain from " + version);
+            net.minecraft.world.item.ItemStack nms = CraftItemStack.asNMSCopy(stack);
+            assertEquals(net.minecraft.world.item.Items.IRON_CHAIN, nms.get(DataComponents.CONTAINER).copyOne().getItem(), "nested chain -> iron_chain from " + version);
+            assertEquals(net.minecraft.world.item.ItemUseAnimation.TRIDENT, nms.get(DataComponents.CONSUMABLE).animation(), "the old spear animation is the trident one from " + version);
+        }
+    }
+
+    @Test
+    public void testEntityTagWithoutId() throws IOException {
+        CompoundTag frame = new CompoundTag();
+        frame.putBoolean("Invisible", true);
+        CompoundTag frameInternal = new CompoundTag();
+        frameInternal.put("EntityTag", frame);
+        CompoundTag egg = new CompoundTag();
+        egg.putBoolean("NoAI", true);
+        CompoundTag eggInternal = new CompoundTag();
+        eggInternal.put("entity-tag", egg);
+
+        // 1.21.4 servers upgrade straight to this version, without re-saving on 1.21.8 first
+        for (int version : new int[]{V1_21_4, V1_21_8}) {
+            ItemStack frameStack = load(version, "ITEM_FRAME", ""
+                + "    meta-type: ENTITY_TAG\n"
+                + "    internal: " + base64(frameInternal) + "\n");
+            net.minecraft.world.item.component.TypedEntityData<net.minecraft.world.entity.EntityType<?>> frameData = CraftItemStack.asNMSCopy(frameStack).get(DataComponents.ENTITY_DATA);
+            assertEquals(net.minecraft.world.entity.EntityTypes.ITEM_FRAME, frameData.type(), "from " + version);
+            assertTrue(frameData.copyTagWithoutId().getBooleanOr("Invisible", false), "from " + version);
+
+            ItemStack eggStack = load(version, "PIG_SPAWN_EGG", ""
+                + "    meta-type: SPAWN_EGG\n"
+                + "    internal: " + base64(eggInternal) + "\n");
+            net.minecraft.world.item.component.TypedEntityData<net.minecraft.world.entity.EntityType<?>> eggData = CraftItemStack.asNMSCopy(eggStack).get(DataComponents.ENTITY_DATA);
+            assertEquals(net.minecraft.world.entity.EntityTypes.PIG, eggData.type(), "from " + version);
+            assertTrue(eggData.copyTagWithoutId().getBooleanOr("NoAI", false), "from " + version);
+        }
+
+        org.bukkit.inventory.meta.SpawnEggMeta meta = (org.bukkit.inventory.meta.SpawnEggMeta) new ItemStack(Material.ZOMBIE_SPAWN_EGG).getItemMeta();
+        meta.setCustomSpawnedType(org.bukkit.entity.EntityType.PIG);
+        meta.setCustomSpawnedType(null);
+        ItemStack api = new ItemStack(Material.ZOMBIE_SPAWN_EGG);
+        assertTrue(api.setItemMeta(meta), "an id-less entity tag must not throw");
+        assertEquals(net.minecraft.world.entity.EntityTypes.ZOMBIE, CraftItemStack.asNMSCopy(api).get(DataComponents.ENTITY_DATA).type());
+    }
 }
