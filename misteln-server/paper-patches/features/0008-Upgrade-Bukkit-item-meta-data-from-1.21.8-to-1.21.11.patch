         ((CraftMetaItem) itemMeta).applyToItem(tag);
@@ -476,6 +481,11 @@ public final class CraftItemStack extends ItemStack {
                 void skullCallback(final ResolvableProfile resolvableProfile) {
                     item.set(DataComponents.PROFILE, resolvableProfile);
                 }
+
+                @Override
+                net.minecraft.world.entity.EntityType<?> itemEntityType() {
+                    return ItemMetaDataUpgrader.entityTypeOf(item); // Misteln - DFU
+                }
