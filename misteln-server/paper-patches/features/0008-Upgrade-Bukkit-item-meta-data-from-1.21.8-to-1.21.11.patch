+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaArmorStand.java
@@ -108,9 +108,12 @@ public class CraftMetaArmorStand extends CraftMetaItem implements com.destroysto
     void applyToItem(CraftMetaItem.Applicator tag) {
         super.applyToItem(tag);
 
-        if (this.entityTag != null) {
-            tag.put(CraftMetaArmorStand.ENTITY_TAG, TypedEntityData.decodeEntity(this.entityTag));
+        // Misteln start - DFU: entity data needs an id since 1.21.9
+        final TypedEntityData<net.minecraft.world.entity.EntityType<?>> entityData = this.entityTag != null ? ItemMetaDataUpgrader.entityData(this.entityTag, tag.itemEntityType()) : null;
+        if (entityData != null) {
+            tag.put(CraftMetaArmorStand.ENTITY_TAG, entityData);
         }
+        // Misteln end
     }
 
     @Override
