diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java
index a9c22da00399f221c921826806e18aed5d449381..1fded8b0fc50a7c0f8330d1f1d3d47f41d88be8f 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java
@@ -421,6 +421,11 @@ public final class CraftItemStack extends ItemStack {
             void skullCallback(final ResolvableProfile profile) {
                 itemStack.set(DataComponents.PROFILE, profile);
             }
+
+            @Override
+            net.minecraft.world.entity.EntityType<?> itemEntityType() {
+                return ItemMetaDataUpgrader.entityTypeOf(itemStack); // Misteln - DFU
