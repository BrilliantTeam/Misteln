+            final CompoundTag upgradedTag = ItemMetaDataUpgrader.upgradeComponents(legacyTag, ItemMetaDataUpgrader.UNKNOWN_ITEM, version);
+            if (!upgradedTag.equals(legacyTag)) {
+                final String[] upgradeError = new String[1];
+                final DataComponentPatch upgradedPatch = DataComponentPatch.CODEC.parse(CraftRegistry.getMinecraftRegistry().createSerializationContext(NbtOps.INSTANCE), upgradedTag).resultOrPartial(e -> upgradeError[0] = e).orElse(DataComponentPatch.EMPTY);
+                error = upgradeError[0];
+                // revert what the components were applied as before the upgrade
+                for (Entry<DataComponentType<?>, Object> entry : legacyPatch.map.entrySet()) {
+                    this.unhandledTags.clear(entry.getKey());
+                    if (Removed.isRemoved(entry.getValue())) {
+                        this.removedTags.remove(entry.getKey());
+                    }
+                }
+                if (CraftMetaItem.getOrEmpty(legacyPatch, CraftMetaItem.CAN_PLACE_ON).isPresent()) {
+                    this.canPlaceOnPredicates = null;
+                }
+                if (CraftMetaItem.getOrEmpty(legacyPatch, CraftMetaItem.CAN_BREAK).isPresent()) {
+                    this.canBreakPredicates = null;
+                }
+                this.applyUnhandled(upgradedPatch);
+            }
+        }
+        if (error != null) {
+            LOGGER.warn("Dropped unreadable item components (data version {}): {}", version, error);
+        }
+        // Misteln end
     }
 
