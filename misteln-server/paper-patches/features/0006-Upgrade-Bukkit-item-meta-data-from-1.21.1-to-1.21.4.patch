diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java b/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
new file mode 100644
index 0000000000000000000000000000000000000000..0bcbba42ac2ff89769c89fb609b56e294900d6b0
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/ItemMetaDataUpgrader.java
@@ -0,0 +1,46 @@
+package org.bukkit.craftbukkit.inventory;
+
+import ca.spottedleaf.dataconverter.minecraft.MCDataConverter;
+import ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.level.block.entity.BlockEntityType;
+import org.bukkit.craftbukkit.util.CraftMagicNumbers;
+import org.jspecify.annotations.Nullable;
+
+// Misteln - DFU: upgrades the raw NBT kept inside Bukkit-serialized item meta (YAML/ConfigurationSerializable)
+// which bypasses the vanilla data converter, e.g. items saved by plugins on an older version and loaded on this one.
+final class ItemMetaDataUpgrader {
+
+    // used when the item type is unknown to the meta, only id specific item stack converters (ominous banner, boats) miss out
+    static final String UNKNOWN_ITEM = "minecraft:stone";
+
+    private ItemMetaDataUpgrader() {
+    }
+
+    static boolean needsUpgrade(final int version) {
+        return version < CraftMagicNumbers.INSTANCE.getDataVersion();
+    }
+
+    // data component patch/map, converted as part of an item stack so item stack level converters (e.g. fire_resistant, lock) apply too
+    static CompoundTag upgradeComponents(final CompoundTag components, final String itemId, final int fromVersion) {
+        final CompoundTag stack = new CompoundTag();
+        stack.putString("id", itemId);
+        stack.putInt("count", 1);
+        stack.put("components", components.copy());
+        return MCDataConverter.convertTag(MCTypeRegistry.ITEM_STACK, stack, fromVersion, CraftMagicNumbers.INSTANCE.getDataVersion()).getCompoundOrEmpty("components");
+    }
+
+    // block entity data without id (as stored by Bukkit), the id is only added for the id specific converters
+    static CompoundTag upgradeBlockEntity(final CompoundTag tag, final @Nullable BlockEntityType<?> type, final int fromVersion) {
+        final CompoundTag copy = tag.copy();
+        final boolean addId = type != null && copy.getString("id").isEmpty();
+        if (addId) {
+            copy.putString("id", net.minecraft.core.registries.BuiltInRegistries.BLOCK_ENTITY_TYPE.getKey(type).toString());
+        }
+        final CompoundTag converted = MCDataConverter.convertTag(MCTypeRegistry.TILE_ENTITY, copy, fromVersion, CraftMagicNumbers.INSTANCE.getDataVersion());
+        if (addId) {
+            converted.remove("id");
+        }
+        return converted;
+    }
+}
