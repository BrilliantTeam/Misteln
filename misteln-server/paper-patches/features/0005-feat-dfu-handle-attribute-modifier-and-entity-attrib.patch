Subject: [PATCH] feat(dfu): handle attribute modifier and entity attribute
 1.20.5/6 to 1.21 upgrade


diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
index f0e04bf3007bdbe968a06707676b43536b56ce9b..36eecaf275d020786806b8d0e27eb95012ebf27b 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
@@ -205,11 +205,27 @@ public class CraftMetaBlockState extends CraftMetaItem implements BlockStateMeta
             this.blockEntityTag = CustomData.of(blockEntityCustomTag);
         });
         tag.getCompound(CraftMetaBlockState.BLOCK_ENTITY_COMPONENTS.NBT).ifPresent(components -> {
+            upgradeAttributeModifiersInComponents(components); // Misteln - upgrade attribute modifiers before codec parse (1.20.5/6 -> 1.21)
             this.components = DataComponentMap.CODEC.parse(CraftRegistry.getMinecraftRegistry().createSerializationContext(NbtOps.INSTANCE), components).getOrThrow();
         });
         // Paper end - new serialization format
     }
 
+    // Misteln start - upgrade attribute modifiers in component map before codec parse (1.20.5/6 -> 1.21)
+    private static void upgradeAttributeModifiersInComponents(CompoundTag components) {
+        components.getCompound("minecraft:attribute_modifiers").flatMap(attributeModifiers -> attributeModifiers.getList("modifiers")).ifPresent(modifiers -> {
+            for (int i = 0; i < modifiers.size(); i++) {
+                modifiers.getCompound(i).ifPresent(CraftMetaItem::upgradeLegacyAttributeModifier);
+            }
+        });
+        components.getList("minecraft:container").ifPresent(container -> {
+            for (int i = 0; i < container.size(); i++) {
+                container.getCompound(i).flatMap(entry -> entry.getCompound("item")).flatMap(item -> item.getCompound("components")).ifPresent(CraftMetaBlockState::upgradeAttributeModifiersInComponents);
+            }
+        });
+    }
+    // Misteln end
+
     @Override
     void serializeInternal(final Map<String, Tag> internalTags) {
         // Paper start - new serialization format
diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
index c0f44885f4dcd3c171d342d67527c2dd26ad18cd..387ceaa377ecf6bcce627bad328bda4f5bf59ec1 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
@@ -824,6 +824,21 @@ class CraftMetaItem implements ItemMeta, Damageable, Repairable, BlockDataMeta {
         }
     }
 
+    // Misteln start - attribute modifier id upgrade (1.20.5/6 -> 1.21), modifiers had a uuid and name instead of an id
+    static void upgradeLegacyAttributeModifier(CompoundTag modifier) {
+        if (modifier.contains("id")) {
+            return;
+        }
+        if (modifier.get("uuid") instanceof net.minecraft.nbt.IntArrayTag uuid) {
+            net.minecraft.core.UUIDUtil.CODEC.parse(NbtOps.INSTANCE, uuid).result().ifPresent(value -> modifier.putString("id", "minecraft:" + value));
+            modifier.remove("uuid");
+        } else {
+            modifier.getString("name").ifPresent(name -> modifier.putString("id", "minecraft:" + name));
+        }
+        modifier.remove("name");
+    }
+    // Misteln end
+
     private static Multimap<Attribute, AttributeModifier> buildModifiersLegacy(CompoundTag tag, ItemMetaKey key) {
         Multimap<Attribute, AttributeModifier> modifiers = LinkedHashMultimap.create();
         ListTag mods = tag.getListOrEmpty(key.NBT);
@@ -833,6 +848,12 @@ class CraftMetaItem implements ItemMeta, Damageable, Repairable, BlockDataMeta {
                 // entry is not an actual CompoundTag. getCompoundOrEmpty returns empty CompoundTag in that case
                 continue;
             }
+            // Misteln start - attribute modifier id upgrade (1.20.5/6 -> 1.21)
+            if (!entry.contains("id")) {
+                entry = entry.copy();
+                CraftMetaItem.upgradeLegacyAttributeModifier(entry);
+            }
+            // Misteln end
             net.minecraft.world.entity.ai.attributes.AttributeModifier nmsModifier = net.minecraft.world.entity.ai.attributes.AttributeModifier.CODEC.parse(NbtOps.INSTANCE, entry).resultOrPartial().orElse(null);
             if (nmsModifier == null) {
                 continue;
