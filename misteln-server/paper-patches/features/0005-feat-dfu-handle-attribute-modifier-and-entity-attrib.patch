diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
index 5a5f6d387a6e763cd673af3d2821f84d0119056e..197885a1231d0548fae6967812a232c0e9f279a8 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaBlockState.java
@@ -207,11 +207,27 @@ public class CraftMetaBlockState extends CraftMetaItem implements BlockStateMeta
             this.blockEntityTag = blockEntityCustomTag.copy();
         });
         tag.getCompound(CraftMetaBlockState.BLOCK_ENTITY_COMPONENTS.NBT).ifPresent(components -> {
+            upgradeAttributeModifiersInComponents(components); // Misteln - upgrade attribute modifiers before codec parse (1.20.5/6 -> 1.21)
             this.components = DataComponentMap.CODEC.parse(CraftRegistry.getMinecraftRegistry().createSerializationContext(NbtOps.INSTANCE), components).getOrThrow();
         });
         // Paper end - new serialization format
     }
 
+    // Misteln start - upgrade attribute modifiers in component map before codec parse (1.20.5/6 -> 1.21)
+    private static void upgradeAttributeModifiersInComponents(CompoundTag components) {
+        components.getCompound("minecraft:attribute_modifiers").flatMap(attributeModifiers -> attributeModifiers.getList("modifiers")).ifPresent(modifiers -> {
+            for (int i = 0; i < modifiers.size(); i++) {
+                modifiers.getCompound(i).ifPresent(CraftMetaItem::upgradeLegacyAttributeModifier);
+            }
+        });
+        components.getList("minecraft:container").ifPresent(container -> {
+            for (int i = 0; i < container.size(); i++) {
+                container.getCompound(i).flatMap(entry -> entry.getCompound("item")).flatMap(item -> item.getCompound("components")).ifPresent(CraftMetaBlockState::upgradeAttributeModifiersInComponents);
+            }
+        });
+    }
+    // Misteln end
+
     @Override
     void serializeInternal(final Map<String, Tag> internalTags) {
         // Paper start - new serialization format
diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
