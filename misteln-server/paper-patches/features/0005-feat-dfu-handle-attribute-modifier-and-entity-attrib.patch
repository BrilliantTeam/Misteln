+    // Misteln start - attribute modifier id upgrade (1.20.5/6 -> 1.21), modifiers had a uuid and name instead of an id
+    static void upgradeLegacyAttributeModifier(CompoundTag modifier) {
+        if (modifier.contains("id")) {
+            return;
+        }
+        if (modifier.get("uuid") instanceof net.minecraft.nbt.IntArrayTag uuid) {
+            net.minecraft.core.UUIDUtil.CODEC.parse(NbtOps.INSTANCE, uuid).result().ifPresent(value -> modifier.putString("id", "minecraft:" + value));
+            modifier.remove("uuid");
+        } else {
+            modifier.getString("name").ifPresent(name -> modifier.putString("id", "minecraft:" + name));
+        }
+        modifier.remove("name");
+    }
+    // Misteln end
+
     private static Multimap<Attribute, AttributeModifier> buildModifiersLegacy(CompoundTag tag, ItemMetaKey key) {
         Multimap<Attribute, AttributeModifier> modifiers = LinkedHashMultimap.create();
         ListTag mods = tag.getListOrEmpty(key.NBT);
@@ -846,6 +861,12 @@ public class CraftMetaItem implements ItemMeta, Damageable, Repairable, BlockDat
