+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaAxolotlBucket.java
@@ -61,6 +61,13 @@ public class CraftMetaAxolotlBucket extends CraftMetaItem implements AxolotlBuck
     void deserializeInternal(CompoundTag tag, Object context) {
         super.deserializeInternal(tag, context);
 
+        // Misteln start - merge EntityTag to entity-tag
+        if (tag.contains("EntityTag")) {
+            tag.put(CraftMetaAxolotlBucket.ENTITY_TAG.NBT, tag.getCompoundOrEmpty("EntityTag"));
+            tag.remove("EntityTag");
+        }
+        // Misteln end
+
         this.entityTag = tag.getCompound(CraftMetaAxolotlBucket.ENTITY_TAG.NBT).orElse(this.entityTag);
         this.bucketEntityTag = tag.getCompound(CraftMetaAxolotlBucket.BUCKET_ENTITY_TAG.NBT).orElse(this.bucketEntityTag);
     }
